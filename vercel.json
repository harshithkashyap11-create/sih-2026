{
  "services": {
    "frontend": {
      "root": "frontend",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "build": {
    "env": {
      "VITE_FRONTEND_URL": "/",
      "VITE_DEMO_MODE": "1"
    }
  }
}

# Generate real values in a secret manager; never commit .env.production.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=care.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://care.example.com
DJANGO_TRUST_PROXY=true
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=smarana
POSTGRES_USER=smarana
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require
REDIS_URL=
# Use a least-privilege S3 account, despite the historical MINIO_ROOT variable names.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=smarana-media-prod
MINIO_ENDPOINT=https://s3.example.com
MINIO_REGION=us-east-1
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
VOICE_LLM_FALLBACK=false
